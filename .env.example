# Supabase project settings (Project Settings -> Data API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign the app's session cookie. Any long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Admin PINs are no longer a single shared env var — each admin has their
# own name + PIN, stored (hashed) in the `users` table. See db/schema.sql
# for the seeded demo admins and how to add more.
